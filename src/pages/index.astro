---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Booking from '../components/Booking.astro';
import Intro from '../components/Intro.astro';
import Backdrop from '../components/Backdrop.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

const title = 'Studio 107 Barbershop | Haircuts & Shaves in Springfield, NJ';
const description =
  'Studio 107 Barbershop, 265 Mountain Ave, Springfield, NJ: detailed haircuts, fades, beard work and hot towel shaves. Book online or call (973) 376-9661.';
---

<Base title={title} description={description}>
  <Backdrop />
  <Nav />
  <main id="main">
    <Intro />
    <Hero />
    <div class="seam" aria-hidden="true"></div>
    <Statement />
    <About />
    <div class="seam" aria-hidden="true"></div>
    <Services />
    <div class="seam" aria-hidden="true"></div>
    <Gallery />
    <div class="seam" aria-hidden="true"></div>
    <Booking />
    <div class="seam" aria-hidden="true"></div>
    <Visit />
    <div class="seam" aria-hidden="true"></div>
  </main>
  <Footer />
  <MobileBar />
  <script>
    import '../scripts/main';
  </script>
</Base>
