---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { business, hours, fullAddress } from '../data/business';
import { services, serviceGroups, priceRange } from '../data/services';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = '/media/og-image.jpg' } = Astro.props;

// Set SITE_URL when deploying (e.g. SITE_URL=https://www.yourdomain.com npm run build).
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const absImage = site ? new URL(image, site).href : image;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BarberShop',
  name: business.name,
  description,
  telephone: business.phone.e164,
  ...(canonical ? { url: canonical, '@id': `${canonical}#barbershop` } : {}),
  image: [absImage],
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  hasMap: business.mapsUrl,
  openingHoursSpecification: hours
    .filter((h) => h.open && h.close)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${h.schemaDay}`,
      opens: h.open,
      closes: h.close,
    })),
  ...(services.length ? {
    priceRange,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Services',
      itemListElement: serviceGroups.map((g) => ({
        '@type': 'OfferCatalog',
        name: g,
        itemListElement: services.filter((s) => s.group === g).map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.name },
          priceSpecification: {
            '@type': 'PriceSpecification',
            priceCurrency: 'USD',
            ...(s.from ? { minPrice: s.price } : { price: s.price }),
          },
        })),
      })),
    },
  } : {}),
  ...(business.booking ? { potentialAction: { '@type': 'ReserveAction', target: business.booking.url } } : {}),
  ...(business.social.length ? { sameAs: business.social.map((s) => s.url) } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0d0c0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${business.name} storefront at ${fullAddress}`} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />

    <meta name="geo.region" content="US-NJ" />
    <meta name="geo.placename" content="Springfield, New Jersey" />

    <link rel="preload" as="image" href="/media/storefront-hero.webp" fetchpriority="high" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
