---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { gallery } from '../data/gallery';
import { bookAttrs } from '../lib/links';

const items = await Promise.all(
  gallery.map(async (g) => {
    const full = await getImage({ src: g.src, format: 'webp', width: Math.min(g.src.width, 1400), quality: 86 });
    return { ...g, full: full.src };
  }),
);
---

<section class="gallery section" id="gallery" aria-labelledby="gallery-title">
  <div class="wrap">
    <header class="gallery__head">
      <div>
        <p class="eyebrow" data-reveal>Gallery</p>
        <h2 id="gallery-title" class="gallery__title display" data-split>
          <span class="split-line"><span>Inside</span></span>
          <span class="split-line" style="--i:1"><span><em class="metal-text">the studio.</em></span></span>
        </h2>
      </div>
      <div class="gallery__intro" data-reveal style="--d:200">
        <p>The real shop on Mountain Avenue. Tap any photo to view it full screen.</p>
        <a class="link-line" {...bookAttrs()}>Book your chair <Icon name="arrow" /></a>
      </div>
    </header>

    <ul class="gallery__grid" role="list" data-gallery>
      {
        items.map((g, i) => (
          <li class:list={['tile', `tile--${g.shape}`, `tile--${i + 1}`]}>
            <button
              type="button"
              class="tile__btn"
              data-lightbox-index={i}
              data-full={g.full}
              data-caption={g.caption}
              data-alt={g.alt}
              aria-label={`View larger: ${g.caption}`}
              data-reveal="clip"
              style={`--d:${(i % 3) * 140}`}
            >
              <Image
                src={g.src}
                alt={g.alt}
                widths={[420, 720, Math.min(g.src.width, 1100)]}
                sizes="(max-width: 760px) 50vw, 33vw"
                format="webp"
                quality={80}
                loading="lazy"
              />
              <span class="tile__cap">
                <span class="tile__num tnum">{String(i + 1).padStart(2, '0')}</span>
                {g.caption}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="lb" role="dialog" aria-modal="true" aria-label="Photo viewer" data-lightbox hidden>
    <div class="lb__stage" data-lb-stage>
      <figure class="lb__fig">
        <img class="lb__img" data-lb-img alt="" />
        <figcaption class="lb__cap">
          <span class="lb__count tnum" data-lb-count></span>
          <span data-lb-caption></span>
          <a class="lb__book" {...bookAttrs()} data-lb-book>Book on Vagaro <Icon name="arrow" /></a>
        </figcaption>
      </figure>
    </div>
    <button class="lb__btn lb__close" type="button" data-lb-close aria-label="Close viewer">
      <Icon name="close" />
    </button>
    <button class="lb__btn lb__prev" type="button" data-lb-prev aria-label="Previous photo">
      <Icon name="chev-left" />
    </button>
    <button class="lb__btn lb__next" type="button" data-lb-next aria-label="Next photo">
      <Icon name="chev-right" />
    </button>
  </div>
</section>

<style>
  .gallery {
    padding-block: clamp(64px, 8vw, 128px);
  }
  .gallery__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: clamp(28px, 4vw, 56px);
  }
  .gallery__head > div {
    display: grid;
    gap: 24px;
  }
  .gallery__title {
    font-size: var(--step-5);
    line-height: 0.9;
  }
  .gallery__intro {
    max-width: 24em;
    color: var(--mist);
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  /* Editorial asymmetric grid */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(60px, 7.2vw, 108px);
    gap: clamp(10px, 1.4vw, 20px);
  }
  .tile {
    min-width: 0;
  }
  .tile--1 { grid-column: 1 / span 5; grid-row: 1 / span 6; }
  .tile--2 { grid-column: 6 / span 4; grid-row: 1 / span 4; }
  .tile--3 { grid-column: 10 / span 3; grid-row: 2 / span 5; }
  .tile--4 { grid-column: 6 / span 4; grid-row: 5 / span 6; }
  .tile--5 { grid-column: 10 / span 3; grid-row: 7 / span 4; }
  .tile--6 { grid-column: 1 / span 5; grid-row: 7 / span 4; }

  .tile__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--char);
    cursor: zoom-in;
  }
  .tile__btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 1400ms var(--ease),
      filter 900ms var(--ease);
    filter: saturate(0.88) brightness(0.92);
  }
  .tile--4 .tile__btn :global(img) { object-position: 50% 35%; }
  .tile--6 .tile__btn :global(img) { object-position: 50% 50%; }
  .tile__btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(8, 8, 8, 0.75), rgba(8, 8, 8, 0) 45%);
    opacity: 0.6;
    transition: opacity 700ms var(--ease);
  }
  .tile__btn::before {
    content: '';
    position: absolute;
    inset: 10px;
    z-index: 2;
    border: 1px solid rgba(214, 218, 224, 0.55);
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 700ms var(--ease),
      transform 700ms var(--ease);
    pointer-events: none;
  }
  .tile__cap {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 16px;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bone);
    text-align: left;
    transform: translateY(6px);
    opacity: 0.85;
    transition:
      transform 700ms var(--ease),
      opacity 700ms var(--ease);
  }
  .tile__num {
    color: var(--silver);
  }
  .tile__btn:hover :global(img),
  .tile__btn:focus-visible :global(img) {
    transform: scale(1.045);
    filter: saturate(1) brightness(1);
  }
  .tile__btn:hover::before,
  .tile__btn:focus-visible::before {
    opacity: 1;
    transform: none;
  }
  .tile__btn:hover::after {
    opacity: 1;
  }
  .tile__btn:hover .tile__cap {
    transform: none;
    opacity: 1;
  }

  @media (max-width: 760px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }
    .tile { grid-column: auto !important; grid-row: auto !important; }
    .tile__btn { aspect-ratio: 4 / 5; }
    .tile--1, .tile--6 { grid-column: 1 / -1 !important; }
    .tile--1 .tile__btn, .tile--6 .tile__btn { aspect-ratio: 4 / 4.4; }
    .tile__cap {
      left: 12px;
      right: 12px;
      bottom: 12px;
      font-size: 0.6rem;
      letter-spacing: 0.14em;
    }
  }

  /* ───────── Lightbox ───────── */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: rgba(6, 6, 6, 0.96);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 600ms var(--ease);
    touch-action: pan-y;
  }
  .lb[hidden] {
    display: none !important;
  }
  .lb.is-open {
    opacity: 1;
  }
  .lb__stage {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: calc(70px + env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px))
      calc(70px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
  }
  .lb__fig {
    display: grid;
    gap: 16px;
    justify-items: center;
    max-height: 100%;
  }
  .lb__img {
    max-width: min(92vw, 1100px);
    max-height: calc(100svh - 190px);
    width: auto;
    height: auto;
    object-fit: contain;
    transition:
      opacity 500ms var(--ease),
      transform 700ms var(--ease);
  }
  .lb__img.is-swap {
    opacity: 0;
    transform: scale(0.985);
  }
  .lb__cap {
    display: flex;
    gap: 14px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone-2);
  }
  .lb__count {
    color: var(--silver);
  }
  .lb__cap {
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }
  .lb__book {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: 10px;
    padding: 9px 14px;
    color: #0c0d0f;
    background: var(--metal);
    border-radius: 100px;
    letter-spacing: 0.16em;
  }
  .lb__book :global(svg) {
    width: 14px;
    height: 14px;
  }
  .lb__btn {
    position: absolute;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(241, 238, 232, 0.18);
    border-radius: 50%;
    color: var(--bone);
    background: rgba(12, 12, 12, 0.5);
    transition:
      border-color var(--t-sm) var(--ease),
      color var(--t-sm) var(--ease);
  }
  .lb__btn:hover {
    border-color: var(--silver);
    color: var(--silver-hi);
  }
  .lb__btn :global(svg) {
    width: 20px;
    height: 20px;
  }
  .lb__close {
    top: calc(16px + env(safe-area-inset-top, 0px));
    right: max(16px, env(safe-area-inset-right, 0px));
  }
  .lb__prev,
  .lb__next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb__prev {
    left: max(20px, env(safe-area-inset-left, 0px));
  }
  .lb__next {
    right: max(20px, env(safe-area-inset-right, 0px));
  }
  @media (max-width: 760px) {
    .lb__prev,
    .lb__next {
      top: auto;
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      transform: none;
    }
    .lb__prev {
      left: calc(50% - 64px);
    }
    .lb__next {
      right: calc(50% - 64px);
    }
  }
</style>
