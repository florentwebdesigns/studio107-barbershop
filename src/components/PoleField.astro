---
/**
 * Scattered line-art barber poles for the deep-brown sections.
 * Each pole is a thin gold outline whose stripes slowly turn. Positions are in % of the section.
 */
type Pole = { x: number; y: number; s?: number; r?: number; o?: number; sm?: boolean };
interface Props { poles: Pole[] }
const { poles } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<div class="pole-field" aria-hidden="true">
  {poles.map((p, i) => (
    <svg
      class:list={['pf-pole', { 'pf-pole--desk': p.sm === false }]}
      viewBox="0 0 24 84"
      style={`--x:${p.x}%;--y:${p.y}%;--s:${p.s ?? 1};--r:${p.r ?? 0}deg;--o:${p.o ?? 0.14};--dl:${(i * -1.3).toFixed(1)}s`}
    >
      <defs>
        <clipPath id={`pf-${uid}-${i}`}><rect x="7.5" y="18.5" width="9" height="45" rx="1" /></clipPath>
      </defs>
      <circle cx="12" cy="8" r="5.5" />
      <path d="M8.5 13.5h7" />
      <rect x="5" y="14" width="14" height="4.5" rx="1.2" />
      <rect x="7.5" y="18.5" width="9" height="45" rx="1" />
      <g clip-path={`url(#pf-${uid}-${i})`}>
        <g class="pf-stripes">
          {Array.from({ length: 12 }, (_, k) => (
            <path d={`M2 ${10 + k * 7} L22 ${2 + k * 7}`} class={k % 2 ? 'pf-s2' : 'pf-s1'} />
          ))}
        </g>
      </g>
      <rect x="5" y="63.5" width="14" height="4.5" rx="1.2" />
      <path d="M8 68v3.5h8V68" />
    </svg>
  ))}
</div>

<style>
  .pole-field { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .pf-pole {
    position: absolute; left: var(--x); top: var(--y);
    width: calc(clamp(26px, 2.5vw, 42px) * var(--s)); height: auto;
    transform: translate(-50%, -50%) rotate(var(--r));
    opacity: var(--o);
    fill: none; stroke: var(--gold); stroke-width: 1.1; stroke-linecap: round; stroke-linejoin: round;
    filter: drop-shadow(0 0 10px rgba(201, 162, 94, 0.35));
    animation: pf-float 14s ease-in-out infinite alternate; animation-delay: var(--dl);
  }
  .pf-stripes { animation: pf-turn 6s linear infinite; animation-delay: var(--dl); }
  .pf-s1 { stroke: var(--gold-hi); stroke-width: 2.4; opacity: 0.9; }
  .pf-s2 { stroke: var(--gold); stroke-width: 0.8; opacity: 0.55; }
  @keyframes pf-turn { from { transform: translateY(0); } to { transform: translateY(-14px); } }
  @keyframes pf-float {
    from { transform: translate(-50%, -50%) rotate(var(--r)); }
    to { transform: translate(-50%, calc(-50% - 10px)) rotate(calc(var(--r) + 3deg)); }
  }
  @media (max-width: 760px) { .pf-pole--desk { display: none; } }
  @media (prefers-reduced-motion: reduce) { .pf-pole, .pf-stripes { animation: none; } }
</style>
