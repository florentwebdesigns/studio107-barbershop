---
/** Minimal line icons, drawn on a 24px grid with a 1.5 stroke. */
interface Props {
  name: 'phone' | 'pin' | 'arrow' | 'arrow-down' | 'clock' | 'close' | 'chev-left' | 'chev-right' | 'calendar' | 'message';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  phone:
    '<path d="M5.2 3.5h3.1l1.6 4.2-2.1 1.4a11.6 11.6 0 0 0 7.1 7.1l1.4-2.1 4.2 1.6v3.1a1.9 1.9 0 0 1-2 1.9A16.6 16.6 0 0 1 3.3 5.5a1.9 1.9 0 0 1 1.9-2Z"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  arrow: '<path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5"/>',
  'arrow-down': '<path d="M12 4v15M6.5 13.5 12 19l5.5-5.5"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  'chev-left': '<path d="M14.5 5.5 8 12l6.5 6.5"/>',
  'chev-right': '<path d="M9.5 5.5 16 12l-6.5 6.5"/>',
  message: '<path d="M4.5 5.5h15a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H10l-4.5 3.5v-3.5h-1a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Z"/><path d="M8 10h8M8 13h5"/>',
  calendar: '<rect x="4" y="5.5" width="16" height="14" rx="1"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
