---
import Icon from './Icon.astro';
import { business } from '../data/business';
const book = business.booking ?? { label: 'Call to Book', url: business.phone.href };
---
<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <!-- The real Studio 107 storefront, brought to life in WebGL (see src/scripts/storefront-hero.ts). -->
  <div class="stage">
    <img class="stage__base" data-hero-base src="/media/storefront-hero.webp" width="2122" height="1356"
      alt="The Studio 107 Barbershop storefront at 265 Mountain Ave, Springfield, NJ: a black sign with gold Studio 107 lettering, a neon OPEN sign in the window, and a barber pole beside the door"
      fetchpriority="high" decoding="async" />
    <canvas class="stage__gl" data-hero-canvas aria-hidden="true"></canvas>
    <div class="stage__shade" aria-hidden="true"></div>
  </div>

  <div class="hero__content wrap">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__kicker" data-hero-in style="--d:0.5s"><span>Barbershop <span aria-hidden="true">·</span> Springfield, New&nbsp;Jersey</span></span>
      <span class="display">
        <span class="line"><span data-hero-line style="--d:0.75s">Your style.</span></span>
        <span class="line"><span data-hero-line style="--d:0.9s"><em class="gold-text">Your standard.</em></span></span>
      </span>
      <span class="sr-only">Studio 107 Barbershop</span>
    </h1>
    <p class="hero__sub" data-hero-in style="--d:1.2s">
      Professional men’s haircuts and grooming at 265 Mountain&nbsp;Ave.
    </p>
    <div class="hero__ctas" data-hero-in style="--d:1.4s">
      <a class="btn btn--gold btn--lg" href={book.url}><Icon name="phone" /> {book.label}</a>
      <a class="btn btn--lg hero__explore" href="#gallery">Explore the Shop <Icon name="arrow" /></a>
    </div>
  </div>

  <aside class="hero__card" data-hero-in style="--d:1.7s" aria-label="Today at Studio 107">
    <p class="hero__card-status"><span class="status-dot" data-open-dot></span><span data-open-status>Mon–Fri 9 AM – 6 PM · Sat 8 AM – 4 PM</span></p>
    <a class="hero__card-row" href={business.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" /> {business.address.street}, {business.address.city}</a>
    <a class="hero__card-row" href={business.phone.href}><Icon name="phone" /> {business.phone.display}</a>
  </aside>

  <a href="#intro" class="hero__scroll" aria-label="Scroll to learn more"><i></i></a>
</section>

<style>
  .hero {
    position: relative; min-height: 100vh; min-height: 100svh; overflow: hidden;
    display: flex; align-items: flex-end; isolation: isolate; background: var(--ink);
  }

  /* ---------- Stage ---------- */
  .stage { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: var(--ink); }
  .stage__base {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%; max-width: none; object-fit: cover;
    filter: contrast(1.05) saturate(0.95) brightness(0.92);
    transform-origin: 50% 40%;
  }
  .stage__gl { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s var(--ease-out); }
  .hero.has-gl .stage__gl { opacity: 1; }
  /* No WebGL: the same photo with a slow CSS push-in. */
  .hero.no-gl .stage__base { animation: push 40s ease-in-out infinite alternate; }
  @keyframes push { from { transform: scale(1); } to { transform: scale(1.06); } }
  .hero.is-portrait .stage__base { -webkit-mask-image: linear-gradient(180deg, #000 80%, transparent); mask-image: linear-gradient(180deg, #000 80%, transparent); }
  @media (prefers-reduced-motion: reduce) { .hero.no-gl .stage__base { animation: none; } }

  .stage__shade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(10, 9, 8, 0.6) 0%, rgba(10, 9, 8, 0) 14%),
      linear-gradient(0deg, rgba(10, 9, 8, 0.92) 0%, rgba(10, 9, 8, 0.55) 26%, rgba(10, 9, 8, 0) 50%),
      radial-gradient(70% 60% at 0% 100%, rgba(10, 9, 8, 0.7) 0%, rgba(10, 9, 8, 0) 70%);
  }

  /* ---------- Content ---------- */
  .hero__content { position: relative; padding-top: calc(var(--nav-h) + 3rem); padding-bottom: clamp(2.25rem, 5.5vh, 4.5rem); }
  .hero__title { display: grid; gap: 1.1rem; font-weight: 400; }
  .hero__kicker {
    display: inline-flex; align-items: center; gap: 0.85rem;
    font-family: var(--sans); font-size: 0.7rem; font-weight: 650; letter-spacing: 0.34em; text-transform: uppercase; color: var(--gold-hi);
  }
  .hero__kicker::before { content: ''; width: 2.25rem; height: 1px; background: currentColor; }
  .hero__title .display { font-size: clamp(2.6rem, 1.2rem + 3.9vw, 5rem); line-height: 0.93; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.45); }
  .hero__title .gold-text { padding-right: 0.06em; }
  .hero__sub { margin-top: 1.2rem; max-width: 36ch; font-size: clamp(1rem, 0.96rem + 0.3vw, 1.15rem); color: rgba(243, 238, 230, 0.88); line-height: 1.55; text-shadow: 0 1px 18px rgba(0, 0, 0, 0.6); }
  .hero__ctas { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .hero__explore { --bd: rgba(243, 238, 230, 0.45); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); background: rgba(13, 12, 11, 0.3); }

  .hero__card {
    position: absolute; right: var(--gutter); bottom: clamp(2.25rem, 5.5vh, 4.5rem); z-index: 1;
    display: grid; gap: 0.15rem; min-width: 18rem; padding: 1.1rem 1.3rem;
    background: rgba(13, 12, 11, 0.55); -webkit-backdrop-filter: blur(14px) saturate(1.2); backdrop-filter: blur(14px) saturate(1.2);
    border: 1px solid rgba(201, 162, 94, 0.28);
  }
  .hero__card-status { display: flex; align-items: center; gap: 0.55rem; font-size: 0.8rem; font-weight: 650; padding-bottom: 0.65rem; margin-bottom: 0.4rem; border-bottom: 1px solid var(--line-light); }
  .hero__card-row { display: flex; align-items: center; gap: 0.6rem; font-size: 0.86rem; color: rgba(243, 238, 230, 0.82); padding-block: 0.25rem; transition: color 0.3s; }
  .hero__card-row:hover { color: var(--gold-hi); }
  .hero__card-row :global(svg) { width: 14px; height: 14px; color: var(--gold); flex: none; }

  .js [data-hero-in] { opacity: 0; transform: translateY(16px); transition: opacity 1.3s var(--ease-out) var(--d), transform 1.3s var(--ease-out) var(--d); }
  .js [data-hero-line] { display: block; transform: translateY(108%); transition: transform 1.5s var(--ease-out) var(--d); }
  .js .hero.is-ready [data-hero-in] { opacity: 1; transform: none; }
  .js .hero.is-ready [data-hero-line] { transform: none; }

  .hero__scroll { position: absolute; left: 50%; bottom: 1.2rem; transform: translateX(-50%); z-index: 1; padding: 0.6rem; }
  .hero__scroll i { display: block; width: 1px; height: 38px; background: linear-gradient(rgba(243, 238, 230, 0.75), transparent); transform-origin: top; animation: scrollcue 2.6s var(--ease-inout) infinite; }
  @keyframes scrollcue { 0% { transform: scaleY(0); } 45% { transform: scaleY(1); transform-origin: top; } 55% { transform: scaleY(1); transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  @media (max-width: 1100px) { .hero__card { display: none; } }

  /* ---------- Phone / portrait: photo on top, copy beneath it ---------- */
  .hero.is-portrait { align-items: stretch; }
  .hero.is-portrait .hero__content { display: flex; flex-direction: column; justify-content: flex-end; padding-top: calc(var(--photo-bottom, 50vh) - 6rem); padding-bottom: 2rem; }
  .hero.is-portrait .stage__shade {
    background:
      linear-gradient(180deg, rgba(10, 9, 8, 0.55) 0%, rgba(10, 9, 8, 0) 12%),
      linear-gradient(0deg, rgba(10, 9, 8, 1) 0%, rgba(10, 9, 8, 0.85) 35%, rgba(10, 9, 8, 0) 55%);
  }
  .hero.is-portrait .hero__scroll { display: none; }
  @media (max-width: 760px) {
    .hero__kicker { font-size: 0.64rem; letter-spacing: 0.26em; }
    .hero__kicker::before { width: 1.5rem; }
    .hero__ctas .btn { flex: 1 1 100%; }
    .hero__title .display { font-size: clamp(2.6rem, 11vw, 3.4rem); }
  }
</style>

<script>
  import { initStorefrontHero } from '../scripts/storefront-hero';
  initStorefrontHero();
</script>
