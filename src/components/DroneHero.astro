---
/**
 * Scroll-driven 3D drone shot of Studio 107 (see src/scripts/drone/).
 * To go back to the photo hero, swap <DroneHero /> for <Hero /> in src/pages/index.astro.
 */
import Icon from './Icon.astro';
import { business } from '../data/business';
const book = business.booking ?? { label: 'Call to Book', url: business.phone.href };
const bookIcon = business.booking ? 'calendar' : 'phone';
const bookExt = business.booking ? { target: '_blank', rel: 'noopener' } : {};
---
<section class="drone is-loading" id="top" data-hero data-drone aria-labelledby="hero-title">
  <div class="drone__sticky">
    <img class="drone__poster" src="/media/storefront-hero.webp" width="2122" height="1356"
      alt="The Studio 107 Barbershop storefront at 265 Mountain Ave, Springfield, NJ: a black sign with gold Studio 107 lettering, a neon open sign in the window, and a barber pole beside the door"
      fetchpriority="high" decoding="async" />
    <canvas class="drone__canvas" data-drone-canvas aria-hidden="true"></canvas>
    <div class="drone__shade" aria-hidden="true"></div>

    <!-- Drone viewfinder -->
    <div class="hud" aria-hidden="true">
      <i class="hud__c hud__c--tl"></i><i class="hud__c hud__c--tr"></i><i class="hud__c hud__c--bl"></i><i class="hud__c hud__c--br"></i>
      <span class="hud__rec"><b></b>REC <span data-hud-time>00:00:00</span></span>
      <span class="hud__alt" data-hud-alt>ALT 05.4 M</span>
      <span class="hud__chap" data-hud-chap>01 · Mountain Ave</span>
      <span class="hud__loc">265 Mountain Ave · Springfield NJ</span>
      <span class="hud__bar"><span data-hud-bar></span></span>
      <span class="hud__cross"></span>
    </div>

    <div class="chapters">
      <div class="chap chap--hero wrap" data-from="-1" data-to="0.075">
        <h1 id="hero-title" class="chap__h1">
          <span class="chap__kicker">Barbershop <span aria-hidden="true">·</span> Springfield, New&nbsp;Jersey</span>
          <span class="display">Your style.<br /><em class="gold-text">Your standard.</em></span>
          <span class="sr-only">Studio 107 Barbershop</span>
        </h1>
        <p class="chap__sub">Professional men’s haircuts and grooming at 265 Mountain&nbsp;Ave.</p>
        <div class="chap__ctas">
          <a class="btn btn--gold btn--lg" href={book.url} {...bookExt}><Icon name={bookIcon} /> {book.label}</a>
          <a class="btn btn--lg chap__ghost" href="#services">See the Menu <Icon name="arrow" /></a>
        </div>
        <a class="chap__phone" href={business.phone.href}><Icon name="phone" /> Or call {business.phone.display}</a>
      </div>

      <div class="chap chap--left wrap" data-from="0.12" data-to="0.3">
        <p class="chap__eyebrow">265 Mountain Ave · Springfield, NJ</p>
        <p class="chap__title">Walk in.<br /><em class="gold-text">Walk out sharp.</em></p>
        <p class="chap__status"><span class="status-dot" data-open-dot></span><span data-open-status>Open six days a week</span></p>
      </div>

      <div class="chap chap--center wrap" data-from="0.45" data-to="0.565">
        <p class="chap__eyebrow">Come on in</p>
        <p class="chap__title chap__title--xl">Step <em class="gold-text">inside.</em></p>
      </div>

      <div class="chap chap--right wrap" data-from="0.63" data-to="0.81">
        <p class="chap__eyebrow">The floor</p>
        <p class="chap__title">Classic chairs.<br /><em class="gold-text">Clean lines.</em></p>
        <p class="chap__body">Reclaimed-wood walls, white mirrors and black barber chairs, modeled on the real Studio&nbsp;107.</p>
      </div>

      <div class="chap chap--menu wrap" data-from="0.9" data-to="1">
        <div>
          <p class="chap__eyebrow">The menu</p>
          <p class="chap__title chap__title--sm">Pick your cut. <em class="gold-text">Book your chair.</em></p>
        </div>
        <div class="chap__ctas">
          <a class="btn btn--gold btn--lg" href={book.url} {...bookExt}><Icon name={bookIcon} /> {book.label}</a>
          <a class="btn btn--lg chap__ghost" href="#services">Full Menu <Icon name="arrow" /></a>
        </div>
      </div>
    </div>

    <div class="drone__cue" data-scroll-cue aria-hidden="true"><span>Scroll to fly in</span><i></i></div>

    <div class="drone__loader" aria-hidden="true">
      <span class="drone__loader-mark">Studio 107</span>
      <span class="drone__loader-bar" data-drone-progress><i></i></span>
    </div>
  </div>
</section>

<script>
  import { initDroneHero } from '../scripts/drone/drone-hero';
  initDroneHero();
</script>

<style>
  .drone { position: relative; height: 760vh; background: #07070a; }
  .drone__sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; isolation: isolate; }
  .drone__poster, .drone__canvas { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
  .drone__poster { object-fit: cover; filter: brightness(0.55) saturate(0.85) blur(2px); transform: scale(1.04); transition: opacity 1.4s var(--ease-out); }
  .drone__canvas { opacity: 0; transition: opacity 1.6s var(--ease-out); }
  .drone.has-gl .drone__canvas { opacity: 1; }
  .drone.has-gl:not(.is-loading) .drone__poster { opacity: 0; }
  .drone__shade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(7, 7, 10, 0.55) 0%, rgba(7, 7, 10, 0) 16%),
      linear-gradient(0deg, rgba(7, 7, 10, 0.75) 0%, rgba(7, 7, 10, 0) 34%);
  }

  /* ---------- HUD ---------- */
  .hud {
    --i: clamp(14px, 2.2vw, 30px);
    position: absolute; inset: calc(var(--nav-h) + 4px) var(--i) var(--i); pointer-events: none;
    font: 600 0.62rem/1 var(--sans); letter-spacing: 0.22em; text-transform: uppercase; color: rgba(243, 238, 230, 0.72);
    font-variant-numeric: tabular-nums;
  }
  .hud__c { position: absolute; width: 22px; height: 22px; border: 1px solid rgba(243, 238, 230, 0.45); }
  .hud__c--tl { left: 0; top: 0; border-right: 0; border-bottom: 0; }
  .hud__c--tr { right: 0; top: 0; border-left: 0; border-bottom: 0; }
  .hud__c--bl { left: 0; bottom: 0; border-right: 0; border-top: 0; }
  .hud__c--br { right: 0; bottom: 0; border-left: 0; border-top: 0; }
  .hud__rec { position: absolute; left: 34px; top: 7px; display: inline-flex; align-items: center; gap: 0.6rem; }
  .hud__rec b { width: 7px; height: 7px; border-radius: 50%; background: #e5484d; box-shadow: 0 0 10px #e5484d; animation: rec 1.6s steps(2, jump-none) infinite; }
  @keyframes rec { 50% { opacity: 0.15; } }
  .hud__alt { position: absolute; right: 34px; top: 7px; }
  .hud__chap { position: absolute; left: 34px; bottom: 7px; color: var(--gold-hi); }
  .hud__loc { position: absolute; right: 34px; bottom: 7px; }
  .hud__bar { position: absolute; left: 34px; right: 34px; bottom: -1px; height: 1px; background: rgba(243, 238, 230, 0.12); }
  .hud__bar span { position: absolute; inset: 0; background: var(--gold-grad); transform-origin: left; transform: scaleX(0); }
  .hud__cross { position: absolute; left: 50%; top: 50%; width: 18px; height: 18px; margin: -9px 0 0 -9px; opacity: 0.35; }
  .hud__cross::before, .hud__cross::after { content: ''; position: absolute; background: rgba(243, 238, 230, 0.8); }
  .hud__cross::before { left: 50%; top: 0; bottom: 0; width: 1px; }
  .hud__cross::after { top: 50%; left: 0; right: 0; height: 1px; }

  /* ---------- Chapters ---------- */
  .chapters { position: absolute; inset: 0; pointer-events: none; }
  .chap { position: absolute; left: 0; right: 0; isolation: isolate; pointer-events: auto; will-change: opacity, transform; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.55); }
  .chap--hero { bottom: clamp(3.2rem, 9vh, 6.5rem); }
  .chap__h1 { display: grid; gap: 1.1rem; font-weight: 400; }
  .chap__kicker, .chap__eyebrow {
    display: inline-flex; align-items: center; gap: 0.85rem;
    font: 650 0.7rem/1.3 var(--sans); letter-spacing: 0.32em; text-transform: uppercase; color: var(--gold-hi);
  }
  .chap__kicker::before, .chap__eyebrow::before { content: ''; width: 2.25rem; height: 1px; background: currentColor; }
  .chap__h1 .display { font-size: clamp(2.7rem, 1.2rem + 4.2vw, 5.4rem); line-height: 0.93; }
  .chap__sub { margin-top: 1.2rem; max-width: 36ch; font-size: clamp(1rem, 0.96rem + 0.3vw, 1.15rem); color: rgba(243, 238, 230, 0.88); line-height: 1.55; }
  .chap__ctas { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .chap__phone { margin-top: 1rem; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.06em; color: rgba(243, 238, 230, 0.85); }
  .chap__phone :global(svg) { width: 14px; height: 14px; color: var(--gold-hi); }
  .chap__phone:hover { color: var(--gold-hi); }
  .chap__ghost { --bd: rgba(243, 238, 230, 0.45); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); background: rgba(13, 12, 11, 0.3); }
  .chap__title { margin-top: 1rem; font-family: var(--serif); font-size: clamp(2.4rem, 1.4rem + 3.4vw, 4.6rem); line-height: 0.98; }
  .chap__title--xl { font-size: clamp(3.4rem, 1.6rem + 6vw, 7.5rem); }
  .chap__title--sm { font-size: clamp(1.9rem, 1.3rem + 1.8vw, 3rem); }
  .chap__body { margin-top: 1rem; max-width: 34ch; color: rgba(243, 238, 230, 0.85); }
  .chap__status { margin-top: 1.2rem; display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; font-weight: 600; color: rgba(243, 238, 230, 0.9); }
  .chap--left { top: 50%; translate: 0 -50%; }
  .chap--left::before, .chap--right::before { content: ''; position: absolute; inset: -30% -10%; z-index: -1; pointer-events: none; }
  .chap--left::before { background: radial-gradient(38% 50% at 22% 50%, rgba(7, 7, 10, 0.55), transparent 75%); }
  .chap--right::before { background: radial-gradient(38% 50% at 80% 50%, rgba(7, 7, 10, 0.55), transparent 75%); }
  .chap--center { top: 50%; translate: 0 -50%; text-align: center; }
  .chap--center .chap__eyebrow { justify-content: center; }
  .chap--right { top: 50%; translate: 0 -50%; display: grid; justify-items: end; text-align: right; }
  .chap--right .chap__eyebrow { flex-direction: row-reverse; }
  .chap--menu { bottom: clamp(2.6rem, 7vh, 4.5rem); display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; }
  .chap--menu .chap__ctas { margin-top: 0; }
  .chap--menu > div:first-child { padding: 1rem 1.3rem; background: rgba(7, 7, 10, 0.55); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid rgba(201, 162, 94, 0.25); }
  .chap--menu .chap__title { margin-top: 0.5rem; }

  /* ---------- Cue & loader ---------- */
  .drone__cue {
    position: absolute; left: 50%; bottom: clamp(1.4rem, 3vh, 2.2rem); translate: -50% 0; display: grid; justify-items: center; gap: 0.6rem;
    font: 650 0.6rem/1 var(--sans); letter-spacing: 0.3em; text-transform: uppercase; color: rgba(243, 238, 230, 0.7); pointer-events: none;
  }
  .drone__cue i { width: 1px; height: 34px; background: linear-gradient(180deg, var(--gold-hi), transparent); animation: cue 2.2s var(--ease-inout) infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  .drone__loader {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1.2rem; background: #07070a;
    transition: opacity 1.2s var(--ease-out), visibility 1.2s; z-index: 5;
  }
  .drone:not(.is-loading) .drone__loader { opacity: 0; visibility: hidden; }
  .drone__loader-mark { font-family: var(--serif); font-style: italic; font-size: 2.4rem; background: var(--gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .drone__loader-bar { width: 140px; height: 1px; background: rgba(243, 238, 230, 0.15); overflow: hidden; }
  .drone__loader-bar { --p: 0.06; }
  .drone__loader-bar i { display: block; height: 100%; width: 100%; background: var(--gold-grad); transform-origin: left; transform: scaleX(var(--p)); transition: transform 0.5s var(--ease-out); }

  /* ---------- No WebGL: photo hero ---------- */
  .drone.no-gl { height: 100vh; height: 100svh; }
  .drone.no-gl .drone__poster { filter: brightness(0.75); transform: none; }
  .drone.no-gl .hud, .drone.no-gl .drone__cue, .drone.no-gl .chap:not(.chap--hero) { display: none; }
  .drone.no-gl .chap--hero { opacity: 1 !important; visibility: visible !important; transform: none !important; }

  @media (max-width: 760px) {
    .drone { height: 640vh; }
    .hud__loc, .hud__cross { display: none; }
    .hud { inset: calc(var(--nav-h) + 2px) 12px 12px; }
    .chap--hero { bottom: 4.6rem; }
    .chap--left, .chap--right, .chap--center { top: auto; bottom: 6.6rem; translate: none; }
    .chap--right { justify-items: start; text-align: left; }
    .chap--right .chap__eyebrow { flex-direction: row; }
    .chap--menu { bottom: 6.2rem; }
    .chap--menu > div:first-child { padding: 0.8rem 1rem; }
    .chap--menu .chap__ctas .chap__ghost { display: none; }
    .drone__cue { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hud__rec b, .drone__cue i { animation: none; }
  }
</style>
