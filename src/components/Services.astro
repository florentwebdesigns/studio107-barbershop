---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services, serviceGroups, formatPrice } from '../data/services';
import { shopImages } from '../data/gallery';
import { business } from '../data/business';
import { bookAttrs, telLink } from '../lib/links';

const groups = serviceGroups.map((g) => ({ name: g, items: services.filter((s) => s.group === g) }));
const shave = services.find((s) => s.signature);
---

<section class="services section blend" id="services" aria-labelledby="services-title">
  <div class="wrap services__grid">
    <header class="services__head">
      <p class="eyebrow" data-reveal>Services & Pricing</p>
      <h2 id="services-title" class="services__title display" data-split>
        <span class="split-line"><span>The</span></span>
        <span class="split-line" style="--i:1"><span><em class="metal-text">menu.</em></span></span>
      </h2>
      <p class="services__lede" data-reveal style="--d:120">
        Tap Book on any service to request a time. It only takes a minute.
      </p>
      <figure class="services__img" data-reveal="clip" style="--d:200">
        <Image
          src={shopImages.stillChairs}
          alt="Classic black barber chairs with chrome bases along the mirrors at Studio 107"
          widths={[400, 640]}
          sizes="(max-width: 900px) 60vw, 26vw"
          format="webp"
          quality={82}
          loading="lazy"
        />
      </figure>
    </header>

    <div class="services__list-wrap">
      {
        groups.map((g, gi) => (
          <div class="menu-group">
            <h3 class="menu-group__name" data-reveal>
              <span class="tnum">{String(gi + 1).padStart(2, '0')}</span>
              {g.name}
            </h3>
            <ul class="menu-list" role="list">
              {g.items.map((s, i) => (
                <li class:list={['menu-item', { 'menu-item--sig': s.signature }]} data-reveal style={`--d:${i * 70}`}>
                  <div class="menu-item__row">
                    <p class="menu-item__name">{s.name}</p>
                    <span class="menu-item__leader" aria-hidden="true" />
                    <p class="menu-item__price tnum">
                      <span class="sr-only">Price: </span>
                      {formatPrice(s)}
                    </p>
                    <a class="menu-item__book" {...bookAttrs(s.name)} aria-label={`Book ${s.name}`}>
                      Book <Icon name="arrow" />
                    </a>
                  </div>
                  {(s.note || s.signature) && (
                    <p class="menu-item__note">{s.signature ? 'What the shop is known for' : s.note}</p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      {
        shave && (
          <aside class="services__shave" data-reveal aria-label="Hot towel shave">
            <div class="services__shave-steam" aria-hidden="true"><i /><i /><i /></div>
            <p class="eyebrow eyebrow--plain">The house specialty</p>
            <p class="services__shave-title display">
              The hot towel <em class="metal-text">shave.</em>
            </p>
            <p class="services__shave-body">
              Studio 107 is known for it. Book it on its own, or mention it when you book your cut.
            </p>
            <div class="services__shave-foot">
              <span class="services__shave-price tnum">{formatPrice(shave)}</span>
              <a class="btn btn--metal" {...bookAttrs(shave.name)}>
                <Icon name="calendar" />
                Book a shave
              </a>
            </div>
          </aside>
        )
      }

      <div class="services__cta" data-reveal>
        <div>
          <p class="services__cta-title display">Not sure what to book?</p>
          <p class="muted">Call the shop and they’ll point you to the right service.</p>
        </div>
        <div class="services__cta-btns">
          <a class="btn btn--metal" {...bookAttrs()}>
            <Icon name="calendar" />
            Book now
          </a>
          <a class="btn btn--ghost" href={telLink()}>
            <Icon name="phone" />
            Call
          </a>
        </div>
        <p class="services__phone tnum">{business.phone.display}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    overflow: hidden;
    --blend-bg:
      radial-gradient(45% 40% at 12% 30%, rgba(207, 198, 184, 0.06), transparent 70%),
      radial-gradient(40% 50% at 100% 100%, rgba(201, 205, 210, 0.07), transparent 70%),
      linear-gradient(180deg, rgba(9, 9, 9, 0.55), rgba(9, 9, 9, 0.2));
  }
  .services__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }
  .services__head {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    display: grid;
    gap: 26px;
    justify-items: start;
  }
  .services__title {
    font-size: var(--step-5);
    line-height: 0.9;
  }
  .services__img {
    width: min(78%, 360px);
    aspect-ratio: 7 / 8;
    overflow: hidden;
    margin-top: 12px;
    background: var(--char);
  }
  .services__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .services__lede {
    max-width: 24em;
    color: var(--mist);
    font-size: 0.95rem;
  }
  .menu-group + .menu-group {
    margin-top: clamp(36px, 4.5vw, 60px);
  }
  .menu-group__name {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-bottom: 14px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--silver);
  }
  .menu-group__name span {
    color: var(--mist-2);
    letter-spacing: 0.1em;
  }
  .menu-list {
    border-top: 1px solid var(--line-strong);
  }
  .menu-item {
    padding: clamp(14px, 1.6vw, 20px) 0;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--t-sm) var(--ease);
  }
  .menu-item__row {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }
  .menu-item__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-2);
    line-height: 1.08;
    letter-spacing: -0.01em;
    min-width: 0;
    transition:
      transform 600ms var(--ease),
      color var(--t-sm) var(--ease);
  }
  .menu-item__leader {
    flex: 1;
    min-width: 24px;
    height: 1px;
    transform: translateY(-0.3em);
    background-image: radial-gradient(circle, rgba(201, 205, 210, 0.55) 1px, transparent 1.3px);
    background-size: 9px 3px;
    background-repeat: repeat-x;
    background-position: 0 50%;
    height: 3px;
  }
  .menu-item__price {
    font-family: var(--font-display);
    font-weight: 500;
    white-space: nowrap;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--silver-hi);
  }
  .menu-item__book {
    flex: none;
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: 6px;
    padding: 10px 14px;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--silver-hi);
    border: 1px solid rgba(201, 205, 210, 0.35);
    border-radius: 100px;
    transition:
      background-color var(--t-sm) var(--ease),
      color var(--t-sm) var(--ease),
      border-color var(--t-sm) var(--ease);
  }
  .menu-item__book :global(svg) {
    width: 14px;
    height: 14px;
    transition: transform var(--t-sm) var(--ease);
  }
  .menu-item__book:hover,
  .menu-item:hover .menu-item__book {
    color: #0c0d0f;
    background: var(--metal);
    border-color: transparent;
  }
  .menu-item__book:hover :global(svg) {
    transform: translateX(3px);
  }
  .menu-item__note {
    margin-top: 8px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .menu-item:hover .menu-item__name {
    transform: translateX(8px);
    font-style: italic;
  }
  .menu-item--sig .menu-item__name {
    font-style: italic;
  }
  .menu-item--sig .menu-item__note {
    color: var(--silver);
  }
  .menu-item--sig .menu-item__price {
    background: var(--metal);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .services__shave {
    position: relative;
    overflow: hidden;
    margin-top: clamp(40px, 5vw, 64px);
    padding: clamp(28px, 3.5vw, 48px);
    display: grid;
    gap: 14px;
    border: 1px solid rgba(201, 205, 210, 0.22);
    background:
      radial-gradient(80% 120% at 100% 0%, rgba(110, 31, 36, 0.22), transparent 60%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0) 55%),
      rgba(10, 10, 11, 0.6);
  }
  .services__shave-title {
    font-size: var(--step-3);
    line-height: 1;
  }
  .services__shave-body {
    color: var(--bone-2);
    max-width: 30em;
  }
  .services__shave-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 8px;
  }
  .services__shave-price {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    color: var(--silver-hi);
  }
  /* Slow rising steam behind the card copy */
  .services__shave-steam {
    position: absolute;
    right: 6%;
    bottom: -20%;
    width: 220px;
    height: 120%;
    pointer-events: none;
    opacity: 0.55;
  }
  .services__shave-steam i {
    position: absolute;
    bottom: 0;
    width: 70px;
    height: 70%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(236, 240, 246, 0.16), transparent);
    filter: blur(12px);
    animation: steam 9s var(--ease-io) infinite;
  }
  .services__shave-steam i:nth-child(1) { left: 10%; animation-delay: 0s; }
  .services__shave-steam i:nth-child(2) { left: 40%; animation-delay: 3s; }
  .services__shave-steam i:nth-child(3) { left: 68%; animation-delay: 6s; }
  @keyframes steam {
    0% { transform: translateY(30%) scaleX(0.6); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateY(-55%) scaleX(1.4); opacity: 0; }
  }

  .services__cta {
    margin-top: clamp(48px, 6vw, 80px);
    padding: clamp(28px, 3.5vw, 44px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px 32px;
    align-items: center;
    border: 1px solid rgba(201, 205, 210, 0.28);
    background:
      linear-gradient(135deg, rgba(201, 205, 210, 0.08), rgba(201, 205, 210, 0) 60%),
      rgba(255, 255, 255, 0.012);
  }
  .services__cta-title {
    font-size: var(--step-2);
    line-height: 1.1;
    margin-bottom: 6px;
  }
  .services__cta-btns {
    display: flex;
    gap: 10px;
  }
  .services__phone {
    grid-column: 2;
    justify-self: center;
    font-size: 0.82rem;
    color: var(--mist);
  }
  .services__phone a {
    color: var(--bone);
    border-bottom: 1px solid rgba(201, 205, 210, 0.5);
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
    .services__head {
      position: static;
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .services__head .eyebrow {
      grid-column: 1 / -1;
    }
    .services__img {
      width: clamp(120px, 34vw, 220px);
      margin-top: 0;
    }
  }
  @media (max-width: 560px) {
    .menu-item__row {
      gap: 12px;
    }
    .menu-item__name,
    .menu-item__price {
      font-size: 1.42rem;
    }
    .services__cta {
      grid-template-columns: 1fr;
    }
    .services__cta-btns {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .menu-item__book {
      padding: 9px 11px;
      margin-left: 2px;
    }
    .menu-item__book :global(svg) {
      display: none;
    }
    .services__phone {
      grid-column: 1;
    }
  }
</style>
