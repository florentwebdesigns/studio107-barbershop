---
/**
 * Studio 107 script wordmark, vector-traced from the shop's own storefront sign.
 * Inherits color from `currentColor`, or uses the brushed-chrome gradient with `metal`.
 */
import pathData from '../assets/logo-path.txt?raw';

interface Props {
  class?: string;
  metal?: boolean;
  title?: string;
}
const { class: className, metal = false, title = 'Studio 107' } = Astro.props;
const gid = `s7m-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['logo', className]}
  viewBox="18 15 1304 196"
  role={title ? 'img' : undefined}
  aria-label={title || undefined}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  {
    metal && (
      <defs>
        <linearGradient id={gid} x1="0" y1="0" x2="1" y2="0.45">
          <stop offset="0" stop-color="#6f747b" />
          <stop offset="0.22" stop-color="#c9ced4" />
          <stop offset="0.38" stop-color="#ffffff" />
          <stop offset="0.52" stop-color="#9aa1a9" />
          <stop offset="0.72" stop-color="#e4e8ec" />
          <stop offset="1" stop-color="#737981" />
        </linearGradient>
      </defs>
    )
  }
  <path d={pathData.trim()} fill={metal ? `url(#${gid})` : 'currentColor'} fill-rule="evenodd"></path>
</svg>

<style>
  .logo {
    width: auto;
    height: 1em;
    overflow: visible;
  }
</style>
