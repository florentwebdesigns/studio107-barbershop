---
import Icon from './Icon.astro';
import { business } from '../data/business';
const book = business.booking ?? { label: 'Call to Book', url: business.phone.href };
const bookIcon = business.booking ? 'calendar' : 'phone';
const bookExt = business.booking ? { target: '_blank', rel: 'noopener' } : {};
---
<div class="mbar" data-mbar>
  <a class="mbar__btn mbar__btn--call" href={book.url} {...bookExt}><Icon name={bookIcon} /> {book.label}</a>
  {business.booking && <a class="mbar__btn mbar__btn--icon" href={business.phone.href} aria-label={`Call ${business.phone.display}`}><Icon name="phone" /></a>}
  <a class="mbar__btn" href={business.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" /> Directions</a>
</div>

<style>
  .mbar { display: none; }
  @media (max-width: 760px) {
    .mbar {
      position: fixed; left: 0.6rem; right: 0.6rem; bottom: calc(0.6rem + env(safe-area-inset-bottom)); z-index: 40;
      display: grid; grid-template-columns: 1.4fr auto 1fr; gap: 0.4rem; padding: 0.4rem;
      background: rgba(13, 12, 11, 0.86); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
      border: 1px solid var(--line-light); border-radius: 6px;
      transform: translateY(calc(100% + 1.5rem)); transition: transform 0.6s var(--ease-out);
    }
    .mbar.is-visible { transform: none; }
    .mbar__btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 50px; border-radius: 3px;
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
      border: 1px solid var(--line-light);
    }
    .mbar__btn--icon { padding-inline: 1rem; }
    .mbar__btn--call { background: var(--gold-grad); color: #15110b; border-color: transparent; }
    .mbar__btn :global(svg) { width: 16px; height: 16px; }
  }
</style>
