---
import Icon from './Icon.astro';
import { business, hoursMondayFirst, formatRange } from '../data/business';
---
<section class="section section--bone visit" id="visit" aria-labelledby="visit-title">
  <div class="wrap visit__grid">
    <div class="visit__info">
      <p class="eyebrow" data-reveal>Visit &amp; contact</p>
      <h2 class="h2" id="visit-title" data-reveal="lines">
        <span class="line"><span>Find us on</span></span>
        <span class="line"><span><em class="gold-text">Mountain Ave.</em></span></span>
      </h2>

      <address class="visit__address" data-reveal>
        <strong>{business.name}</strong>
        <span>{business.address.street}</span>
        <span>{business.address.city}, {business.address.region} {business.address.postalCode}</span>
      </address>

      <a class="visit__phone" href={business.phone.href} data-reveal>
        <span class="visit__phone-label">Call to book</span>
        <span class="visit__phone-num">{business.phone.display}</span>
      </a>

      <div class="visit__actions" data-reveal>
        <a class="btn btn--dark" href={business.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" /> Get Directions</a>
        <a class="btn btn--ghost-dark" href={business.phone.href}><Icon name="phone" /> Call Now</a>
      </div>
    </div>

    <div class="visit__hours" id="hours" data-reveal style="--d:0.1s">
      <div class="hours__head">
        <h3 class="h3">Hours</h3>
        <p class="hours__status"><span class="status-dot" data-open-dot></span><span data-open-status>Open six days a week</span></p>
      </div>
      <table class="hours__table">
        <caption class="sr-only">Studio 107 Barbershop business hours</caption>
        <tbody>
          {hoursMondayFirst.map((h) => (
            <tr data-day={h.schemaDay} class={!h.open ? 'is-closed' : ''}>
              <th scope="row">{h.day}</th>
              <td>{formatRange(h)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="visit__map" data-reveal="mask">
      <iframe
        title="Map showing Studio 107 Barbershop at 265 Mountain Ave, Springfield, NJ"
        src={business.mapsEmbedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
      <a class="visit__map-link" href={business.mapsUrl} target="_blank" rel="noopener">Open in Google Maps <Icon name="arrow-up-right" /></a>
    </div>

    <figure class="visit__photo" data-reveal="mask" style="--d:0.15s">
      <img src="/media/storefront-sm.webp" alt="Studio 107 Barbershop's black and gold sign above the front window at 265 Mountain Ave" width="1000" height="639" loading="lazy" decoding="async" />
      <figcaption>Look for the black-and-gold sign and the barber pole.</figcaption>
    </figure>
  </div>
</section>

<style>
  .visit__grid {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(2.5rem, 5vw, 4.5rem) clamp(1rem, 2vw, 2rem);
    grid-template-areas:
      'i i i i i i . h h h h h'
      'm m m m m m m m p p p p';
  }
  .visit__info { grid-area: i; display: grid; gap: 1.8rem; align-content: start; }
  .visit__address { font-style: normal; display: grid; gap: 0.1rem; font-size: 1.1rem; color: var(--muted-dark); }
  .visit__address strong { font-weight: 650; color: var(--text-dark); }
  .visit__phone { display: grid; gap: 0.2rem; justify-self: start; }
  .visit__phone-label { font-size: 0.66rem; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700; color: var(--gold-lo); }
  .visit__phone-num { font-family: var(--serif); font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.6rem); line-height: 1; color: var(--text-dark); border-bottom: 1px solid var(--line-dark); padding-bottom: 0.3rem; transition: color 0.3s, border-color 0.3s; }
  .visit__phone:hover .visit__phone-num { color: var(--gold-lo); border-color: var(--gold-lo); }
  .visit__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .visit__hours { grid-area: h; background: var(--paper); padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--line-dark); align-self: start; }
  .hours__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .hours__status { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.85rem; font-weight: 600; color: var(--muted-dark); }
  .hours__table { width: 100%; border-collapse: collapse; font-size: 1rem; }
  .hours__table th, .hours__table td { padding: 0.8rem 0; border-top: 1px solid var(--line-dark); text-align: left; font-weight: 500; }
  .hours__table td { text-align: right; font-variant-numeric: tabular-nums; color: var(--text-dark); }
  .hours__table th { color: var(--muted-dark); }
  .hours__table tr.is-closed td { color: var(--muted-dark); }
  .hours__table tr.is-today th, .hours__table tr.is-today td { color: var(--text-dark); font-weight: 750; }
  .hours__table tr.is-today th::after { content: 'Today'; margin-left: 0.6rem; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; padding: 0.2rem 0.45rem; background: var(--ink); color: var(--gold-hi); vertical-align: 0.15em; }

  .visit__map { grid-area: m; position: relative; min-height: 420px; background: #d9d1c3; overflow: hidden; }
  .visit__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(0.85) sepia(0.15) contrast(1.05); }
  .visit__map-link {
    position: absolute; left: 1rem; bottom: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.7rem 1rem; background: var(--ink); color: var(--text-light);
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; transition: background 0.3s, color 0.3s;
  }
  .visit__map-link:hover { background: var(--gold); color: var(--ink); }
  .visit__map-link :global(svg) { width: 14px; height: 14px; }
  .visit__photo { grid-area: p; position: relative; overflow: hidden; align-self: stretch; min-height: 260px; }
  .visit__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 35% 40%; position: absolute; inset: 0; }
  .visit__photo figcaption {
    position: absolute; inset: auto 0 0 0; padding: 2.5rem 1.1rem 1rem; color: var(--text-light);
    background: linear-gradient(0deg, rgba(10, 9, 8, 0.85), transparent);
    font-family: var(--serif); font-style: italic; font-size: 1.15rem; line-height: 1.25;
  }

  @media (max-width: 1000px) {
    .visit__grid { grid-template-columns: 1fr 1fr; grid-template-areas: 'i i' 'h h' 'm m' 'p p'; }
    .visit__map { min-height: 340px; }
    .visit__photo { aspect-ratio: 16 / 9; min-height: 0; }
  }
  @media (max-width: 520px) {
    .visit__actions .btn { flex: 1 1 100%; }
  }
</style>
