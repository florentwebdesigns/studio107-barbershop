---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business, hoursMondayFirst, formatRange } from '../data/business';
const links = [
  { href: '#top', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#services', label: 'Services' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#visit', label: 'Contact' },
];
const book = business.booking ?? { label: 'Call to Book', url: business.phone.href };
const bookIcon = business.booking ? 'calendar' : 'phone';
const bookExt = business.booking ? { target: '_blank', rel: 'noopener' } : {};
---
<header class="nav" data-nav>
  <div class="nav__inner">
    <a href="#top" class="nav__brand" aria-label="Studio 107 Barbershop — home"><Logo /></a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href} data-navlink>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="nav__actions">
      <a class="nav__phone" href={business.phone.href}>{business.phone.display}</a>
      <a class="btn btn--gold nav__cta" href={book.url} {...bookExt}>
        <Icon name={bookIcon} /> <span>{book.label}</span>
      </a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Open menu</span>
        <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <div class="menu__inner">
    <nav aria-label="Mobile">
      <ol class="menu__links">
        {links.map((l, i) => (
          <li style={`--i:${i}`}><a href={l.href} data-menu-link><span class="menu__num">0{i + 1}</span>{l.label}</a></li>
        ))}
      </ol>
    </nav>
    <div class="menu__foot">
      <a class="btn btn--gold btn--lg" href={book.url} {...bookExt}><Icon name={bookIcon} /> <span>{book.label}</span></a>
      <a class="btn btn--lg menu__call" href={business.phone.href}><Icon name="phone" /> <span style="white-space:nowrap">{business.phone.display}</span></a>
      <div class="menu__meta">
        <p>{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postalCode}</p>
        <p class="muted">Mon–Fri {formatRange(hoursMondayFirst[0])}<br />Sat {formatRange(hoursMondayFirst[5])}<br />Sun Closed</p>
      </div>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    height: var(--nav-h);
    transition: background 0.5s var(--ease-out), backdrop-filter 0.5s, border-color 0.5s, transform 0.6s var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .nav.is-solid {
    background: rgba(13, 12, 11, 0.78);
    -webkit-backdrop-filter: blur(16px) saturate(1.2); backdrop-filter: blur(16px) saturate(1.2);
    border-color: var(--line-light);
  }
  .nav.is-hidden { transform: translateY(-100%); }
  .nav__inner {
    height: 100%; max-width: 1600px; margin-inline: auto; padding-inline: var(--gutter);
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
  }
  .nav__brand { flex: none; }
  .nav__links ul { display: flex; gap: clamp(1.25rem, 2.4vw, 2.6rem); }
  .nav__links a {
    position: relative; font-size: 0.74rem; font-weight: 650; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(243, 238, 230, 0.82); padding-block: 0.5rem; transition: color 0.3s;
  }
  .nav__links a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.15rem; height: 1px; background: var(--gold);
    transform: scaleX(0); transform-origin: right; transition: transform 0.5s var(--ease-out);
  }
  .nav__links a:hover, .nav__links a.is-active { color: var(--text-light); }
  .nav__links a:hover::after, .nav__links a.is-active::after { transform: scaleX(1); transform-origin: left; }
  .nav__actions { display: flex; align-items: center; gap: 1.4rem; }
  .nav__phone { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; color: var(--muted-light); transition: color 0.3s; }
  .nav__phone:hover { color: var(--gold-hi); }
  .nav__cta { min-height: 44px; padding: 0.7rem 1.15rem; font-size: 0.7rem; }
  .nav__toggle { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; }
  .nav__burger { position: relative; width: 26px; height: 10px; }
  .nav__burger i { position: absolute; left: 0; right: 0; height: 1.5px; background: var(--text-light); transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out); }
  .nav__burger i:first-child { top: 0; }
  .nav__burger i:last-child { top: 8.5px; }
  [aria-expanded='true'] .nav__burger i:first-child { top: 4.25px; transform: rotate(45deg); }
  [aria-expanded='true'] .nav__burger i:last-child { top: 4.25px; transform: rotate(-45deg); }

  @media (max-width: 1100px) { .nav__phone { display: none; } }
  @media (max-width: 900px) {
    .nav__links { display: none; }
    .nav__toggle { display: inline-flex; }
  }
  @media (max-width: 520px) {
    .nav__cta span { display: none; }
    .nav__cta { width: 44px; padding: 0; }
  }

  /* Mobile menu */
  .menu {
    position: fixed; inset: 0; z-index: 45; background: var(--ink);
    padding: calc(var(--nav-h) + 2rem) var(--gutter) calc(2rem + env(safe-area-inset-bottom));
    display: flex; overflow-y: auto;
    clip-path: inset(0 0 100% 0); transition: clip-path 0.8s var(--ease-inout);
  }
  .menu[hidden] { display: none; }
  .menu.is-open { clip-path: inset(0 0 0 0); }
  .menu__inner { width: 100%; display: flex; flex-direction: column; justify-content: space-between; gap: 3rem; }
  .menu__links li { overflow: hidden; border-bottom: 1px solid var(--line-light); }
  .menu__links a {
    display: flex; align-items: baseline; gap: 1rem; padding-block: 0.9rem;
    font-family: var(--serif); font-size: clamp(2.4rem, 11vw, 3.6rem); line-height: 1;
    transform: translateY(110%); transition: transform 0.9s var(--ease-out); transition-delay: calc(0.25s + var(--i) * 0.06s);
  }
  .menu.is-open .menu__links a { transform: none; }
  .menu__num { font-family: var(--sans); font-size: 0.7rem; letter-spacing: 0.2em; color: var(--gold); }
  .menu__foot { display: grid; gap: 1.75rem; }
  .menu__call { margin-top: -1.1rem; }
  .menu__foot .btn { width: 100%; white-space: normal; flex-wrap: wrap; column-gap: 0.6rem; }
  .menu__meta { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.9rem; line-height: 1.55; }
</style>
