---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business } from '../data/business';
import { hoursSummary } from '../lib/hours';
import { telLink, bookAttrs, directionsLink } from '../lib/links';

const links = [
  { href: '#top', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#services', label: 'Services' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#visit', label: 'Contact' },
];
const summary = hoursSummary();
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a href="#top" class="nav__brand" aria-label="Studio 107 Barbershop, back to top">
      <Logo class="nav__logo" />
      <span class="nav__brand-sub" aria-hidden="true">Barbershop</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} data-navlink>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav__actions">
      <a class="nav__phone tnum" href={telLink()}>
        <Icon name="phone" />
        <span>{business.phone.display}</span>
      </a>
      <a class="btn btn--metal nav__cta" {...bookAttrs()}>Book Now</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only" data-menu-label>Open menu</span>
        <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Site menu" data-menu hidden>
  <div class="menu__bg" aria-hidden="true"></div>
  <div class="menu__inner">
    <nav aria-label="Mobile">
      <ol class="menu__links">
        {links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} data-menu-link>
              <span class="menu__num tnum">{String(i + 1).padStart(2, '0')}</span>
              <span class="menu__label">{l.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="menu__foot">
      <a class="btn btn--metal menu__cta" {...bookAttrs()} data-menu-link>
        <Icon name="calendar" /> Book on Vagaro
      </a>
      <div class="menu__info">
        <div>
          <p class="menu__k">Visit</p>
          <a href={directionsLink()} target="_blank" rel="noopener">
            {business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postalCode}
          </a>
        </div>
        <div>
          <p class="menu__k">Hours</p>
          <ul class="tnum">
            {summary.map((s) => (
              <li><span>{s.days}</span><span>{s.range}</span></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="menu__k">Call</p>
          <a class="tnum" href={telLink()}>{business.phone.display}</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    padding-top: env(safe-area-inset-top, 0px);
    transition:
      background-color 700ms var(--ease),
      border-color 700ms var(--ease),
      transform 700ms var(--ease);
    border-bottom: 1px solid transparent;
  }
  .nav::before {
    /* soft top scrim for legibility over the live hero */
    content: '';
    position: absolute;
    inset: 0 0 -40px 0;
    background: linear-gradient(to bottom, rgba(8, 8, 8, 0.55), rgba(8, 8, 8, 0));
    pointer-events: none;
    transition: opacity 700ms var(--ease);
  }
  .nav.is-solid {
    background: rgba(12, 12, 11, 0.82);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    border-color: var(--line);
  }
  .nav.is-solid::before {
    opacity: 0;
  }

  .nav__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--nav-h);
    max-width: calc(var(--max) + var(--gutter) * 2);
    margin-inline: auto;
    padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
    padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
    transition: height 700ms var(--ease);
  }
  .nav.is-solid .nav__bar {
    height: 64px;
  }

  /* Stacked like the storefront sign: script wordmark over wide-tracked BARBERSHOP */
  .nav__brand {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    color: var(--bone);
  }
  .nav__brand :global(.nav__logo) {
    height: 27px;
    transition: height 700ms var(--ease);
  }
  .nav.is-solid :global(.nav__logo) {
    height: 23px;
  }
  .nav__brand-sub {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.62em;
    margin-right: -0.62em;
    text-transform: uppercase;
    color: var(--mist);
  }

  .nav__links ul {
    display: flex;
    gap: clamp(20px, 2.6vw, 40px);
  }
  .nav__links a {
    position: relative;
    display: inline-block;
    padding: 8px 0;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone-2);
    transition: color var(--t-sm) var(--ease);
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--silver);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 600ms var(--ease);
  }
  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--bone);
  }
  .nav__links a:hover::after,
  .nav__links a.is-active::after {
    transform: scaleX(1);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--bone-2);
    transition: color var(--t-sm) var(--ease);
  }
  .nav__phone:hover {
    color: var(--silver-hi);
  }
  .nav__phone :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--silver);
  }
  .nav__cta {
    --btn-pad-y: 14px;
    --btn-pad-x: 22px;
    min-height: 44px;
    font-size: 0.68rem;
  }

  .nav__toggle {
    display: none;
    width: 46px;
    height: 46px;
    margin-right: -10px;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
  }
  .nav__burger {
    position: relative;
    width: 24px;
    height: 10px;
  }
  .nav__burger i {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: var(--bone);
    transition:
      transform 600ms var(--ease),
      top 600ms var(--ease),
      width 600ms var(--ease);
  }
  .nav__burger i:first-child {
    top: 0;
  }
  .nav__burger i:last-child {
    top: 8.5px;
    left: auto;
    width: 16px;
  }
  .nav__toggle[aria-expanded='true'] .nav__burger i:first-child {
    top: 4.25px;
    transform: rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] .nav__burger i:last-child {
    top: 4.25px;
    width: 24px;
    transform: rotate(-45deg);
  }

  @media (max-width: 1080px) {
    .nav__links,
    .nav__phone {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .nav__cta {
      display: none;
    }
    .nav__toggle {
      display: inline-flex;
    }
    .nav__brand :global(.nav__logo) {
      height: 23px;
    }
    .nav__brand-sub {
      font-size: 0.44rem;
    }
  }

  /* ───────── Full-screen menu ───────── */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--nav-h) + env(safe-area-inset-top, 0px));
    padding-bottom: calc(28px + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    visibility: hidden;
  }
  .menu[hidden] {
    display: none !important;
  }
  .menu.is-open {
    visibility: visible;
  }
  .menu__bg {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(120% 60% at 100% 0%, rgba(201, 205, 210, 0.12), transparent 60%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.018) 0 2px, transparent 2px 18px),
      #0c0c0b;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 900ms var(--ease);
  }
  .menu.is-open .menu__bg {
    clip-path: inset(0 0 0 0);
  }
  .menu__inner {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding-left: max(24px, env(safe-area-inset-left, 0px));
    padding-right: max(24px, env(safe-area-inset-right, 0px));
    padding-top: 12px;
  }
  .menu__links li {
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .menu__links a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 14px 0 12px;
    transform: translateY(105%);
    transition: transform 900ms var(--ease);
    transition-delay: calc(150ms + var(--i) * 60ms);
  }
  .menu.is-open .menu__links a {
    transform: none;
  }
  .menu__num {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--silver);
    min-width: 1.6em;
  }
  .menu__label {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 11vw, 3.6rem);
    line-height: 1;
    color: var(--bone);
  }
  .menu__links a:active .menu__label {
    font-style: italic;
  }
  .menu__foot {
    display: grid;
    gap: 28px;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 800ms var(--ease) 450ms,
      transform 800ms var(--ease) 450ms;
  }
  .menu.is-open .menu__foot {
    opacity: 1;
    transform: none;
  }
  .menu__cta {
    width: 100%;
  }
  .menu__info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 20px;
    font-size: 0.86rem;
    color: var(--bone-2);
    line-height: 1.55;
  }
  .menu__info > div:nth-child(2) {
    grid-row: span 2;
  }
  .menu__info li {
    display: flex;
    flex-direction: column;
    margin-bottom: 6px;
  }
  .menu__info li span:first-child {
    color: var(--mist);
    font-size: 0.78rem;
  }
  .menu__k {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--silver);
    margin-bottom: 8px;
  }
</style>
